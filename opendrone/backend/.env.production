DJANGO_SETTINGS_MODULE=config.settings.production

# Core
SECRET_KEY=CAMBIA-CON-UNA-STRINGA-RANDOM-DI-50-CARATTERI
DEBUG=False
ALLOWED_HOSTS=api.tuodominio.it,tuodominio.it
CSRF_TRUSTED_ORIGINS=https://api.tuodominio.it,https://tuodominio.it

# Database RDS
DB_NAME=opendrone
DB_USER=opendrone_user
DB_PASSWORD=CAMBIA-PASSWORD-DB
